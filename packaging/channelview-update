#!/usr/bin/python3
"""channelview-update - install the newest channelview release published on GitHub.

    sudo channelview-update              look for a newer release, show what is new, ask, install it
    channelview-update --check           only look; exit status 10 = an update is available (for cron, or a Zabbix item)
    sudo channelview-update --yes        no questions - this is what the optional systemd timer runs
    sudo channelview-update --version 1.0.1 --force     install a specific release (also an older one)

Settings (command line > environment > /etc/default/channelview):
    CHANNELVIEW_UPDATE_REPO         GitHub repository, owner/name        (set when the package was built)
    CHANNELVIEW_UPDATE_CHANNEL      stable (default) | prerelease
    CHANNELVIEW_UPDATE_TOKEN_FILE   file holding a GitHub token, only needed when the repository is private

What it does, in this order, and stops at the first problem:
  1. asks the GitHub API for the release (https only; the token is never sent to another host than the API's)
  2. downloads channelview_<version>_all.deb and SHA256SUMS from that release
  3. checks the .deb against SHA256SUMS; if /etc/channelview/release-key.gpg exists, SHA256SUMS must also carry a valid
     signature (SHA256SUMS.sig) from that key - without a signature or with a wrong one nothing is installed
  4. checks that the file really is the channelview package of that version
  5. installs it with apt-get (dependencies are resolved, your changed /etc/default/channelview is kept); the package restarts the service

Exit status: 0 done / already up to date, 1 error, 10 update available (--check).
Standard library only; needs Python 3.9+ (the same as the dashboard itself).
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PACKAGE = "channelview"
DEFAULTS_FILE = "/etc/default/channelview"
DEFAULT_API = "https://api.github.com"
DEFAULT_KEYRING = "/etc/channelview/release-key.gpg"
CACHE_DIR = "/var/cache/channelview-update"
OK, ERROR, UPDATE_AVAILABLE = 0, 1, 10
PLACEHOLDER_REPO = "OWNER/REPO"
REPO_RX = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
DEB_RX = re.compile(r"^channelview_([0-9][0-9A-Za-z.+~-]*)_all\.deb$")
SUMS_NAME = "SHA256SUMS"
SIG_NAMES = ("SHA256SUMS.sig", "SHA256SUMS.asc")
MAX_DEB = 50 * 1024 * 1024
MAX_SMALL = 1024 * 1024
TIMEOUT = 30
QUIET = False


class Fail(Exception):
    pass


def say(msg=""):
    if not QUIET:
        print(msg, flush=True)


# --------------------------------------------------------------------------- Debian version order (policy 5.6.12), so no dpkg is needed to compare

def _order(c):
    if c == "~":
        return -1
    if c.isdigit():
        return 0
    if c.isalpha():
        return ord(c)
    return ord(c) + 256


def _cmp_part(a, b):
    i = j = 0
    while i < len(a) or j < len(b):
        first_diff = 0
        while (i < len(a) and not a[i].isdigit()) or (j < len(b) and not b[j].isdigit()):
            ac = _order(a[i]) if i < len(a) else 0
            bc = _order(b[j]) if j < len(b) else 0
            if ac != bc:
                return -1 if ac < bc else 1
            i += 1
            j += 1
        while i < len(a) and a[i] == "0":
            i += 1
        while j < len(b) and b[j] == "0":
            j += 1
        while i < len(a) and a[i].isdigit() and j < len(b) and b[j].isdigit():
            if not first_diff:
                first_diff = ord(a[i]) - ord(b[j])
            i += 1
            j += 1
        if i < len(a) and a[i].isdigit():
            return 1
        if j < len(b) and b[j].isdigit():
            return -1
        if first_diff:
            return -1 if first_diff < 0 else 1
    return 0


def _split_version(v):
    epoch, rest = (v.split(":", 1) if ":" in v else ("0", v))
    upstream, revision = (rest.rsplit("-", 1) if "-" in rest else (rest, ""))
    return int(epoch) if epoch.isdigit() else 0, upstream, revision


def compare_versions(a, b):
    """-1, 0 or 1 like dpkg --compare-versions: 1.0.0~rc.1 < 1.0.0 < 1.0.1 < 1.0.10."""
    ea, ua, ra = _split_version(a)
    eb, ub, rb = _split_version(b)
    if ea != eb:
        return -1 if ea < eb else 1
    return _cmp_part(ua, ub) or _cmp_part(ra, rb)


# --------------------------------------------------------------------------- settings

def read_defaults(path):
    """KEY=VALUE lines of /etc/default/channelview (the same file the systemd unit reads)."""
    out = {}
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] in "#;" or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        out[k.strip()] = v
    return out


def setting(name, cli, defaults, fallback=""):
    return cli or os.environ.get(name) or defaults.get(name) or fallback


def read_token(path):
    if not path:
        return ""
    p = Path(path)
    try:
        st = p.stat()
        token = p.read_text(encoding="utf-8").strip()
    except OSError as e:
        raise Fail(f"cannot read the token file {path}: {e}")
    if st.st_mode & 0o044:
        print(f"warning: {path} can be read by other users - run: chmod 600 {path}", file=sys.stderr)
    return token


# --------------------------------------------------------------------------- HTTP

class _SafeRedirect(urllib.request.HTTPRedirectHandler):
    """Follows redirects (release assets are served from another host) but never takes the GitHub token along to a different host,
    and never follows a redirect from https to plain http."""

    def __init__(self, allow_http):
        self.allow_http = allow_http

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = urllib.parse.urlsplit(newurl)
        old = urllib.parse.urlsplit(req.full_url)
        if new.scheme != "https" and not (self.allow_http and new.scheme == "http"):
            raise urllib.error.URLError(f"refusing a redirect to {new.scheme}://{new.netloc}")
        r = super().redirect_request(req, fp, code, msg, headers, newurl)
        if r is not None and new.netloc != old.netloc:
            r.headers.pop("Authorization", None)
            r.unredirected_hdrs.pop("Authorization", None)
        return r


class Http:
    def __init__(self, api, token):
        self.api = api.rstrip("/")
        self.token = token
        self.allow_http = urllib.parse.urlsplit(self.api).scheme == "http"      # only when --api-url says so explicitly (tests, a local mirror)
        if urllib.parse.urlsplit(self.api).scheme not in ("https", "http"):
            raise Fail(f"bad API address {api}")
        self.opener = urllib.request.build_opener(_SafeRedirect(self.allow_http))

    def _request(self, url, accept, with_token=True):
        scheme = urllib.parse.urlsplit(url).scheme
        if scheme != "https" and not (self.allow_http and scheme == "http"):
            raise Fail(f"refusing to fetch {url}: only https is allowed")
        req = urllib.request.Request(url, headers={"User-Agent": "channelview-update", "Accept": accept})
        if self.token and with_token:
            req.add_header("Authorization", "Bearer " + self.token)
        return req

    def _open(self, req):
        try:
            return self.opener.open(req, timeout=TIMEOUT)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                raise Fail("not found (404): check the repository name; a private repository needs CHANNELVIEW_UPDATE_TOKEN_FILE")
            if e.code in (403, 429) and e.headers.get("X-RateLimit-Remaining") == "0":
                raise Fail("the GitHub API rate limit is used up - try again later (a token raises the limit)")
            if e.code in (401, 403):
                raise Fail(f"GitHub refused access (HTTP {e.code}): is the token in CHANNELVIEW_UPDATE_TOKEN_FILE valid for this repository?")
            raise Fail(f"GitHub answered HTTP {e.code} for {req.full_url}")
        except (urllib.error.URLError, OSError) as e:
            raise Fail(f"cannot reach {req.full_url}: {getattr(e, 'reason', e)}")

    def json(self, path):
        with self._open(self._request(self.api + path, "application/vnd.github+json")) as r:
            data = r.read(MAX_SMALL * 4)
        try:
            return json.loads(data)
        except ValueError:
            raise Fail("GitHub sent something that is not JSON")

    def download(self, asset, dest, limit):
        """Public repositories: the browser_download_url. Private ones: the API url with an octet-stream Accept header."""
        if self.token and asset.get("url"):
            req = self._request(asset["url"], "application/octet-stream")
        else:
            req = self._request(asset["browser_download_url"], "application/octet-stream", with_token=False)
        size = 0
        with self._open(req) as r, open(dest, "wb") as f:
            while True:
                chunk = r.read(65536)
                if not chunk:
                    break
                size += len(chunk)
                if size > limit:
                    raise Fail(f"{asset['name']} is larger than {limit // 1024} KiB - refusing it")
                f.write(chunk)
        os.chmod(dest, 0o644)


# --------------------------------------------------------------------------- releases

def deb_asset(release):
    for a in release.get("assets") or []:
        if DEB_RX.match(a.get("name", "")):
            return a
    return None


def asset_version(asset):
    """The Debian version a release file stands for. Pre-releases are published as channelview_1.1.0-rc.1_all.deb because GitHub renames
    a '~' in file names to '.', while the package itself says 1.1.0~rc.1 (sorts before 1.1.0). The packages carry no Debian revision
    (-1, -2 ...), so a '-' in the file name always means '~'."""
    return DEB_RX.match(asset["name"]).group(1).replace("-", "~")


def find_release(http, repo, channel, pinned):
    base = f"/repos/{repo}"
    if pinned:
        pinned = pinned[1:] if pinned.startswith("v") else pinned
        last = None
        for tag in ("v" + pinned, pinned):
            try:
                return http.json(f"{base}/releases/tags/{urllib.parse.quote(tag)}")
            except Fail as e:
                last = e
        raise Fail(f"no release tagged v{pinned} in {repo} ({last})")
    if channel == "stable":
        try:
            return http.json(f"{base}/releases/latest")
        except Fail as e:
            raise Fail(f"no stable release found in {repo}: {e}")
    best = None
    for r in http.json(f"{base}/releases?per_page=30"):
        if r.get("draft") or not deb_asset(r):
            continue
        if best is None or compare_versions(asset_version(deb_asset(r)), asset_version(deb_asset(best))) > 0:
            best = r
    if best is None:
        raise Fail(f"{repo} has no release with a {PACKAGE}_<version>_all.deb file")
    return best


def installed_version():
    try:
        out = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev} ${Version}", PACKAGE], capture_output=True, text=True).stdout
    except OSError:
        return None
    status, _, version = out.strip().partition(" ")
    return version.strip() if status.startswith("ii") and version.strip() else None


# --------------------------------------------------------------------------- checks of what was downloaded

def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def check_checksum(sums_path, deb_path):
    want = None
    for line in Path(sums_path).read_text(encoding="utf-8", errors="replace").splitlines():
        m = re.match(r"^([0-9a-fA-F]{64})\s+\*?(.+?)\s*$", line)
        if m and m.group(2) == deb_path.name:
            want = m.group(1).lower()
    if want is None:
        raise Fail(f"{SUMS_NAME} has no line for {deb_path.name} - refusing to install")
    got = sha256_of(deb_path)
    if got != want:
        raise Fail(f"SHA-256 of {deb_path.name} does not match {SUMS_NAME} (download {got[:16]}..., expected {want[:16]}...) - nothing installed")


def check_signature(keyring, sums_path, sig_path):
    gpgv = shutil.which("gpgv")
    if not gpgv:
        raise Fail(f"{keyring} exists, so releases must be signed, but gpgv is not installed (apt install gpgv)")
    if sig_path is None:
        raise Fail(f"{keyring} exists, so releases must be signed, but this release has no {' / '.join(SIG_NAMES)} - nothing installed")
    r = subprocess.run([gpgv, "--keyring", keyring, str(sig_path), str(sums_path)], capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail("the signature of SHA256SUMS is not valid for the key in " + keyring + " - nothing installed\n" + r.stderr.strip())


def check_package_file(deb_path, version):
    if not shutil.which("dpkg-deb"):
        raise Fail("dpkg-deb not found - is this a Debian / Ubuntu system?")
    r = subprocess.run(["dpkg-deb", "-f", str(deb_path), "Package", "Version", "Architecture"], capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail(f"{deb_path.name} is not a valid .deb file")
    fields = dict(line.split(": ", 1) for line in r.stdout.splitlines() if ": " in line)
    if fields.get("Package") != PACKAGE or fields.get("Architecture") != "all" or fields.get("Version") != version:
        raise Fail(f"{deb_path.name} contains {fields.get('Package')} {fields.get('Version')} ({fields.get('Architecture')}), not {PACKAGE} {version} (all)")


def run_install(deb_path, allow_downgrade, reinstall=False):
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    if shutil.which("apt-get"):
        cmd = ["apt-get", "install", "-y", "--no-install-recommends", "-o", "Dpkg::Options::=--force-confold"]
        if allow_downgrade:
            cmd.append("--allow-downgrades")
        if reinstall:
            cmd.append("--reinstall")
        if QUIET:
            cmd.append("-qq")
        cmd.append(str(deb_path))
    else:
        cmd = ["dpkg", "-i", "--force-confold", str(deb_path)]
    if subprocess.run(cmd, env=env).returncode != 0:
        raise Fail("the installation failed - see the messages above (the old version is still installed unless dpkg says otherwise)")


# --------------------------------------------------------------------------- main

def work_dir(args):
    if args.download_dir:
        d = Path(args.download_dir)
        d.mkdir(parents=True, exist_ok=True)
        return d, False
    if os.geteuid() == 0:
        os.makedirs(CACHE_DIR, mode=0o755, exist_ok=True)
        os.chmod(CACHE_DIR, 0o755)
        d = Path(tempfile.mkdtemp(prefix="dl-", dir=CACHE_DIR))
        os.chmod(d, 0o755)      # apt's sandbox user must be able to read the file
        return d, True
    return Path(tempfile.mkdtemp(prefix="channelview-update-")), True


def run(args):
    global QUIET
    QUIET = args.quiet
    defaults = read_defaults(args.defaults_file)
    repo = setting("CHANNELVIEW_UPDATE_REPO", args.repo, defaults)
    channel = setting("CHANNELVIEW_UPDATE_CHANNEL", args.channel, defaults, "stable")
    if not repo or repo == PLACEHOLDER_REPO:
        raise Fail(f"no GitHub repository is set: put CHANNELVIEW_UPDATE_REPO=owner/name into {args.defaults_file} (or use --repo owner/name)")
    if not REPO_RX.match(repo):
        raise Fail(f"'{repo}' is not a GitHub repository name (owner/name)")
    if channel not in ("stable", "prerelease"):
        raise Fail("channel must be stable or prerelease")
    token = read_token(setting("CHANNELVIEW_UPDATE_TOKEN_FILE", args.token_file, defaults))
    http = Http(args.api_url, token)

    installed = installed_version()
    release = find_release(http, repo, channel, args.version)
    asset = deb_asset(release)
    if not asset:
        raise Fail(f"release {release.get('tag_name')} has no {PACKAGE}_<version>_all.deb file")
    version = asset_version(asset)
    say(f"{PACKAGE}: installed {installed or 'none'}, release {release.get('tag_name')} on GitHub ({repo}) is {version}")

    cmp = compare_versions(version, installed) if installed else 1
    if cmp == 0 and not args.force:
        say("Already up to date.")
        return OK
    if cmp < 0 and not (args.force and args.version):
        say("The installed version is newer than that release." + ("" if args.version else " Nothing to do."))
        if args.version:
            say("Use --force to install an older release on purpose.")
        return OK
    if args.check:
        say(f"Update available: {installed or 'none'} -> {version}")
        return UPDATE_AVAILABLE

    notes = (release.get("body") or "").strip()
    if notes:
        say("\nWhat is new:\n  " + "\n  ".join(notes.splitlines()[:20]) + ("\n  ..." if len(notes.splitlines()) > 20 else "") + "\n")
    if not args.download_only:
        if os.geteuid() != 0:
            raise Fail("installing needs root - run it with sudo")
        if not args.yes:
            if not sys.stdin.isatty():
                raise Fail("not on a terminal: add --yes to install without asking")
            if input(f"Install {PACKAGE} {version}? [y/N] ").strip().lower() not in ("y", "yes"):
                say("Cancelled.")
                return OK

    by_name = {a["name"]: a for a in release.get("assets") or []}
    if SUMS_NAME not in by_name:
        raise Fail(f"release {release.get('tag_name')} has no {SUMS_NAME} file - refusing to install an unchecked package")
    sig_name = next((n for n in SIG_NAMES if n in by_name), None)
    keyring = args.keyring or DEFAULT_KEYRING
    need_signature = os.path.exists(keyring)

    workdir, temporary = work_dir(args)
    try:
        deb_path, sums_path = workdir / asset["name"], workdir / SUMS_NAME
        say(f"Downloading {asset['name']} ({asset.get('size', 0) // 1024} KiB) ...")
        http.download(asset, deb_path, MAX_DEB)
        http.download(by_name[SUMS_NAME], sums_path, MAX_SMALL)
        check_checksum(sums_path, deb_path)
        say("SHA-256 matches " + SUMS_NAME)
        if need_signature:
            sig_path = None
            if sig_name:
                sig_path = workdir / sig_name
                http.download(by_name[sig_name], sig_path, MAX_SMALL)
            check_signature(keyring, sums_path, sig_path)
            say("Signature is valid")
        else:
            say(f"(no {keyring}: release signatures are not checked)")
        check_package_file(deb_path, version)
        if args.download_only:
            say(f"Downloaded and checked: {deb_path}\nInstall it with: sudo apt install {deb_path}")
            temporary = False
            return OK
        say(f"Installing {PACKAGE} {version} ...")
        run_install(deb_path, allow_downgrade=cmp < 0, reinstall=cmp == 0)
        now = installed_version()
        say(f"Done: {PACKAGE} {installed or 'none'} -> {now}" + ("" if now == version else f"  (expected {version}!)"))
        return OK if now == version else ERROR
    finally:
        if temporary:
            shutil.rmtree(workdir, ignore_errors=True)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="channelview-update", description="Install the newest channelview release from GitHub.",
                                 epilog="Exit status: 0 done / up to date, 1 error, 10 update available (--check).")
    ap.add_argument("--check", action="store_true", help="only look for an update (exit status 10 when there is one)")
    ap.add_argument("-y", "--yes", action="store_true", help="install without asking")
    ap.add_argument("-q", "--quiet", action="store_true", help="print nothing but errors")
    ap.add_argument("--version", metavar="X.Y.Z", default="", help="install this release instead of the latest one")
    ap.add_argument("--force", action="store_true", help="reinstall the same version, or (with --version) go back to an older one")
    ap.add_argument("--channel", choices=("stable", "prerelease"), default="", help="stable (default): only full releases")
    ap.add_argument("--repo", default="", metavar="OWNER/NAME", help="GitHub repository (default: CHANNELVIEW_UPDATE_REPO)")
    ap.add_argument("--token-file", default="", help="file with a GitHub token (private repositories)")
    ap.add_argument("--keyring", default="", help=f"GPG keyring that releases must be signed with (default: {DEFAULT_KEYRING}, if it exists)")
    ap.add_argument("--download-only", action="store_true", help="download and check the package, do not install it")
    ap.add_argument("--download-dir", default="", help="keep the download in this folder")
    ap.add_argument("--api-url", default=DEFAULT_API, help="GitHub API address (GitHub Enterprise: https://HOST/api/v3)")
    ap.add_argument("--defaults-file", default=DEFAULTS_FILE, help=argparse.SUPPRESS)
    args = ap.parse_args(argv)
    try:
        return run(args)
    except Fail as e:
        print(f"channelview-update: {e}", file=sys.stderr)
        return ERROR
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
