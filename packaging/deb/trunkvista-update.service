[Unit]
Description=Install a new trunkvista release from GitHub, if there is one
Documentation=file:///usr/share/doc/trunkvista/README.md.gz
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/trunkvista
ExecStart=/usr/bin/trunkvista-update --yes --quiet
