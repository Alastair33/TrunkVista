[Unit]
Description=Install a new channelview release from GitHub, if there is one
Documentation=file:///usr/share/doc/channelview/README.md.gz
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/channelview
ExecStart=/usr/bin/channelview-update --yes --quiet
