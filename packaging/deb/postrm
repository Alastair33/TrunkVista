#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = "remove" ] && command -v deb-systemd-helper >/dev/null 2>&1; then
    deb-systemd-helper mask 'trunkvista.service' 'trunkvista-update.timer' >/dev/null || true
fi

if [ "$1" = "purge" ]; then
    if [ -e /usr/share/debconf/confmodule ]; then
        . /usr/share/debconf/confmodule
        db_purge || true
    fi
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper purge 'trunkvista.service' 'trunkvista-update.timer' >/dev/null || true
        deb-systemd-helper unmask 'trunkvista.service' 'trunkvista-update.timer' >/dev/null || true
    fi
    rm -rf /var/cache/trunkvista-update
    rmdir /etc/trunkvista 2>/dev/null || true
    if [ -d /etc/trunkvista ]; then
        cat <<'MSG'
trunkvista: /etc/trunkvista (the HTTPS certificate and key from trunkvista-cert, the update signing key) was kept. To remove it:
    sudo rm -rf /etc/trunkvista
MSG
    fi
    if [ -d /var/lib/trunkvista ]; then
        cat <<'MSG'
trunkvista: /var/lib/trunkvista (your layouts, the saved Zabbix connection with its API token, the accounts) and the
trunkvista system user were kept, so a reinstall picks up where you left off. To remove them for good:
    sudo rm -rf /var/lib/trunkvista && sudo deluser --system trunkvista
MSG
    fi
fi

exit 0
