[Unit]
Description=Zabbix weathermap dashboard
Documentation=file:///usr/share/doc/trunkvista/README.md.gz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trunkvista
Group=trunkvista
# Defaults; /etc/default/trunkvista overrides them (listen address, port, extra options).
Environment=TRUNKVISTA_HOST=127.0.0.1
Environment=TRUNKVISTA_PORT=8088
Environment=TRUNKVISTA_ARGS=
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/trunkvista
# systemd creates /var/lib/trunkvista for the service user: connections.json (the Zabbix API token, owner-only), the layouts,
# config.json, the accounts (users.json) and the signed-in sessions live there. --require-login: never an open dashboard, even if the accounts file is lost.
StateDirectory=trunkvista
StateDirectoryMode=0750
WorkingDirectory=/var/lib/trunkvista
ExecStart=/usr/lib/trunkvista/trunkvista.py --no-browser --host ${TRUNKVISTA_HOST} --port ${TRUNKVISTA_PORT} --data-dir /var/lib/trunkvista --require-login $TRUNKVISTA_ARGS
Restart=on-failure
LimitNOFILE=4096
RestartSec=5
UMask=0077

# Sandbox: the dashboard only needs the network and its own data folder.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# A port below 1024 needs:  systemctl edit trunkvista   ->   [Service]  AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
