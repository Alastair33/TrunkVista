# /etc/default/channelview - read by channelview.service and by channelview-update.
# After a change:   sudo systemctl restart channelview

# Where the dashboard listens.
#   127.0.0.1   only this machine (default, the safe choice)
#   0.0.0.0     all network interfaces: other PCs and wall displays on the LAN can open it.
#               Everybody has to sign in (accounts: sudo channelview-user --help, or the account menu in the page).
#               Do switch on HTTPS (below) first: without it passwords cross the network readable.
CHANNELVIEW_HOST=127.0.0.1
CHANNELVIEW_PORT=8088

# HTTPS - recommended as soon as the dashboard is opened from other PCs (the passwords then travel encrypted):
#   sudo channelview-cert          makes a self-signed certificate in /etc/channelview/tls (or use your own / Let's Encrypt files)
# then remove the two # below and restart. The certificate files are re-read when they change, so a renewal needs no restart.
# The files must be readable by the group channelview (the key: chmod 640, chgrp channelview).
#CHANNELVIEW_TLS_CERT=/etc/channelview/tls/server.crt
#CHANNELVIEW_TLS_KEY=/etc/channelview/tls/server.key

# More options for channelview.py (channelview --help), e.g.  --config /var/lib/channelview/other.json
CHANNELVIEW_ARGS=

# Updates from GitHub releases:  sudo channelview-update
CHANNELVIEW_UPDATE_REPO=@REPO@
# stable = full releases only, prerelease = release candidates too
CHANNELVIEW_UPDATE_CHANNEL=stable
# Only for a private repository: a file (chmod 600) holding a GitHub token that may read the repository's releases.
CHANNELVIEW_UPDATE_TOKEN_FILE=
