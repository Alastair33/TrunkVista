#!/bin/sh
# trunkvista-user - the TrunkVista accounts.   Run it with sudo; a running dashboard sees every change at once.
#
#   sudo trunkvista-user list                                  who can sign in
#   sudo trunkvista-user add NAME --role admin                 asks for the password (admin may edit, viewer only looks)
#   sudo trunkvista-user add tv --role viewer --idle never --random-password      a wall display that never signs out
#   sudo trunkvista-user passwd NAME                           new password; ends every session of that account
#   sudo trunkvista-user set NAME --idle 30                    sign out after 30 minutes without activity (or: --idle never)
#   sudo trunkvista-user set NAME --role viewer | --disable | --enable
#   sudo trunkvista-user signout NAME                          end every session of that account
#   sudo trunkvista-user delete NAME
# More:  trunkvista-user --help      (the same things can be done by an administrator in the page: account menu > Users)
DATA="${TRUNKVISTA_DATA:-/var/lib/trunkvista}"
if [ "$(id -u)" != 0 ] && [ -d "$DATA" ] && [ ! -w "$DATA" ]; then
    echo "trunkvista-user: the accounts belong to the service; run it with sudo:  sudo trunkvista-user $*" >&2
    exit 1
fi
exec /usr/lib/trunkvista/trunkvista.py user --data-dir "$DATA" "$@"
