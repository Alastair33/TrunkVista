#!/bin/sh
# channelview-user - the ChannelView accounts.   Run it with sudo; a running dashboard sees every change at once.
#
#   sudo channelview-user list                                  who can sign in
#   sudo channelview-user add NAME --role admin                 asks for the password (admin may edit, viewer only looks)
#   sudo channelview-user add tv --role viewer --idle never --random-password      a wall display that never signs out
#   sudo channelview-user passwd NAME                           new password; ends every session of that account
#   sudo channelview-user set NAME --idle 30                    sign out after 30 minutes without activity (or: --idle never)
#   sudo channelview-user set NAME --role viewer | --disable | --enable
#   sudo channelview-user signout NAME                          end every session of that account
#   sudo channelview-user delete NAME
# More:  channelview-user --help      (the same things can be done by an administrator in the page: account menu > Users)
DATA="${CHANNELVIEW_DATA:-/var/lib/channelview}"
if [ "$(id -u)" != 0 ] && [ -d "$DATA" ] && [ ! -w "$DATA" ]; then
    echo "channelview-user: the accounts belong to the service; run it with sudo:  sudo channelview-user $*" >&2
    exit 1
fi
exec /usr/lib/channelview/channelview.py user --data-dir "$DATA" "$@"
